                    "$ref": "#/components/schemas/SyncHistoryEntry"
                  },
                  "type": "array",
                  "title": "Response Sync History Api V1 Audit Sync History Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/audit/overlap-map": {
      "get": {
        "tags": [
          "audit"
        ],
        "summary": "Overlap Map",
        "description": "Return statements grouped by account with pairwise period overlap detection.",
        "operationId": "overlap_map_api_v1_audit_overlap_map_get",
        "responses": {
          "200": {
