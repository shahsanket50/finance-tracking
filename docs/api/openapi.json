  "components": {
    "schemas": {
      "AccountBalanceResponse": {
        "properties": {
          "account_ref": {
            "type": "string",
            "title": "Account Ref"
          },
          "account_type": {
            "type": "string",
            "title": "Account Type"
          },
          "derived_balance_paise": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Derived Balance Paise"
          },
          "outstanding_liability_paise": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outstanding Liability Paise"
          },
          "anchor_period_end": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Anchor Period End"
          }
        },
        "type": "object",
        "required": [
          "account_ref",
          "account_type",
          "derived_balance_paise",
          "outstanding_liability_paise",
          "anchor_period_end"
        ],
        "title": "AccountBalanceResponse"
      },
      "AccountCreate": {
        "properties": {
          "nickname": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Nickname"
          },
          "account_type": {
            "type": "string",
            "enum": [
              "savings",
              "current",
              "credit_card",
              "investment"
            ],
            "title": "Account Type"
          },
          "last4": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4,
                "minLength": 4,
                "pattern": "^\\d{4}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last4"
          },
          "account_ref": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Account Ref"
          }
        },
        "type": "object",
        "required": [
          "nickname",
          "account_type",
          "account_ref"
        ],
        "title": "AccountCreate"
      },
      "AccountOverlap": {
        "properties": {
          "account_ref": {
            "type": "string",
            "title": "Account Ref"
          },
          "statements": {
            "items": {
              "$ref": "#/components/schemas/StatementBar"
            },
            "type": "array",
            "title": "Statements"
          }
        },
        "type": "object",
        "required": [
          "account_ref",
          "statements"
        ],
        "title": "AccountOverlap"
      },
      "AccountResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "nickname": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nickname"
          },
          "account_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
