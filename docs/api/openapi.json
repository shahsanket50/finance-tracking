        "tags": [
          "accounts"
        ],
        "summary": "Update Account",
        "description": "Update account metadata (nickname, type, last4).",
        "operationId": "update_account_api_v1_accounts__account_id__patch",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "required": true,
